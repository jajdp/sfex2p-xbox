# Nothing that belongs to the game ever goes in here. Blocked by extension, so it cannot slip in
# by accident, and not as a substitute for reading NOTICE.md.

# disc images and dumps
*.bin
*.BIN
*.cue
*.iso
*.img
*.chd
*.pbp
*.ecm

# BIOS
*.rom
SCPH*
scph*

# executables, debug info and packages
*.exe
*.dll
*.pdb
*.ilk
*.msix
*.msixbundle
*.appx
*.appxbundle
*.appxsym
*.appxupload

# signing certificates: yours is yours
*.pfx
*.p12
*.cer
*.snk

# saves and states
*.mcd
*.mcr
*.srm
*.sav
*.pst
*.state
saves/

# leftovers of a game project, in case this is cloned inside one
build/
build-*/
logs/
disc/
bios/
mods/state.toml
psx_freeze_dump_*.json
psx_last_run_report.json
overlay_captures*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# editors and OS
.vs/
.vscode/
.idea/
*.swp
*.log
*.tmp
Thumbs.db
desktop.ini
.DS_Store

# The package tiles are supplied by whoever packages (docs/ASSETS.md); no game art is distributed here.
package/Assets/*.png

# parche_fondo_cadena.py stays out: it fixed the drawing chain inside the 16:9 mod's plugin, and that
# fix is already part of the plugin jajdp/sfex2p-widescreen publishes.
tools/parche_fondo_cadena.py
